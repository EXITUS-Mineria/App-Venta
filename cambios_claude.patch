+// Archivo de propuesta final y nombres de descarga.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import "./ayuda.mjs";
+import { leerCSV, extraerCuentas } from "../modulos/venta/propuesta_final.js";
